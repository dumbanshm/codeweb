PORT=3000
NODE_ENV=development

# Local Neo4j example:
# NEO4J_URI=bolt://localhost:7687
#
# AuraDB example:
NEO4J_URI=neo4j+s://YOUR_AURA_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# "Explain this node" AI feature — free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Abuse guardrails for /api/analyze-github (defaults shown)
# MAX_REPO_SIZE_KB=20000
# CLONE_TIMEOUT_MS=20000

# express-session cookie signing secret — set a real random value in production
SESSION_SECRET=replace_me
